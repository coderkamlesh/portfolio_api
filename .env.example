# ============================================================================
# Portfolio API — environment template
# Copy to .env (git-ignored) and fill in the values.
# ============================================================================

# ---- Server ----
SERVER_PORT=8080
# Comma-separated frontend origins allowed by CORS (admin panel).
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Turso (libSQL) ----
TURSO_DATABASE_URL=turso://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ---- Tokens / JWT ----
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=generate-a-long-random-string-min-32-chars
JWT_ISSUER=portfolio-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---- Admin auth policy (login + email OTP 2FA) ----
# true  = email OTP is mandatory for every admin (recommended)
# false = OTP only when the admin enabled it in the panel
AUTH_2FA_REQUIRED=true
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_PER_WINDOW=5
AUTH_OTP_WINDOW_MINUTES=60
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=15

# ---- Email delivery ----
# ses = send via AWS SES (production) | log = print the OTP to server logs (local dev)
EMAIL_PROVIDER=ses

# ---- AWS SES credentials ----
# Locally / in CI set the access key pair.
# On Lambda leave AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY empty so the
# function's execution role is used instead (no long-lived keys in the console).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Verified SES identity that sends the OTP mails (must be verified in SES).
SES_FROM_EMAIL=no-reply@yourdomain.com
SES_FROM_NAME=Portfolio Admin
# Where replies should go (optional).
SES_REPLY_TO=you@yourdomain.com
# Optional SES configuration set for bounce/complaint tracking.
SES_CONFIGURATION_SET=
# Optional endpoint override, e.g. http://localhost:4566 for LocalStack.
SES_ENDPOINT_URL=